# Server-only API base URL. The frontend runs on 3001; backend defaults to 3000.
API_BASE_URL=http://localhost:3000/api/v1
# Hosted backend: https://fieldops-api-xu3s.onrender.com/api/v1
APP_ORIGIN=http://localhost:3001

# Dedicated frontend session storage. Start with docker compose up -d sessions.
# Production requires a private authenticated TLS Redis URL (rediss://).
SESSION_REDIS_URL=redis://127.0.0.1:6397
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep the same key across application instances/restarts; never commit its value.
SESSION_ENCRYPTION_KEY=

# Optional public Web client ID; must match backend Google audience and allowed origin.
GOOGLE_CLIENT_ID=

# Optional dedicated demo accounts, read only on the server. Backend determines role.
# Use disposable sandbox accounts, never real operator/customer credentials.
DEMO_CUSTOMER_EMAIL=
DEMO_CUSTOMER_PASSWORD=
DEMO_TECHNICIAN_EMAIL=
DEMO_TECHNICIAN_PASSWORD=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
# Never add gateway credentials, tokens, or demo passwords to NEXT_PUBLIC_*.
