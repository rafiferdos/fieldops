{
  "name": "fieldops",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "lint:fix": "eslint . --fix",
